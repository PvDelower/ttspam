# Backend запускается на порту 8000
API_HOST=0.0.0.0
API_PORT=8000

# TikTok OAuth (получи от https://developer.tiktok.com/)
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here
TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok/callback

# Папка для хранения файлов
STORAGE_DIR=storage

# FFmpeg (убедись что установлены ffmpeg и ffprobe)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Максимальный размер видео (в MB)
MAX_VIDEO_SIZE_MB=5000

# Log level
LOG_LEVEL=INFO
